---
import type { Page } from 'astro';

interface Props { page: Page }
const { page } = Astro.props;

const DIGITS = ['〇', '一', '二', '三', '四', '五', '六', '七', '八', '九'];

/** 阿拉伯数字转中文（1–99，超出则退回数字）。原来只写到「十」，第 11 页会变成 "11"。 */
function cn(n: number): string {
  if (n < 1 || n > 99) return String(n);
  if (n < 10) return DIGITS[n];
  const [t, o] = [Math.floor(n / 10), n % 10];
  return (t > 1 ? DIGITS[t] : '') + '十' + (o ? DIGITS[o] : '');
}

const href = (n: number) => (n === 1 ? '/' : `/${n}`);

/** 只显示首页、末页和当前页前后各 radius 页，中间用省略号占位 */
function windowed(current: number, last: number, radius = 1): (number | '…')[] {
  if (last <= 7) return Array.from({ length: last }, (_, i) => i + 1);
  const keep = new Set([1, last]);
  for (let i = current - radius; i <= current + radius; i++) {
    if (i >= 1 && i <= last) keep.add(i);
  }
  const out: (number | '…')[] = [];
  let prev = 0;
  for (const n of [...keep].sort((a, b) => a - b)) {
    if (prev && n - prev > 1) out.push('…');
    out.push(n);
    prev = n;
  }
  return out;
}

const items = windowed(page.currentPage, page.lastPage);
---

{page.lastPage > 1 && (
  <nav class="pager" aria-label="分页">
    <a class:list={['step', { off: !page.url.prev }]} href={page.url.prev ?? '#'} aria-disabled={!page.url.prev}>上一页</a>
    <div class="nums">
      <span class="rule" aria-hidden="true"></span>
      {items.map((n) =>
        n === '…' ? (
          <span class="gap" aria-hidden="true">…</span>
        ) : (
          <a class="num" href={href(n)} aria-current={n === page.currentPage ? 'page' : undefined}>
            <span>{cn(n)}</span>
            <span class="dot" aria-hidden="true"></span>
          </a>
        ),
      )}
      <span class="rule" aria-hidden="true"></span>
    </div>
    <a class:list={['step', { off: !page.url.next }]} href={page.url.next ?? '#'} aria-disabled={!page.url.next}>下一页</a>
  </nav>
)}
