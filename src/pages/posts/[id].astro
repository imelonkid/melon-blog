---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { allPosts, formatDate } from '../../lib/posts';
import { SITE } from '../../consts';

export const getStaticPaths = (async () => {
  const posts = await allPosts();
  return posts.map((post, i) => {
    // 文章在列表里的序号决定它落在第几页；返回链接指向那一页，
    // 而不是一律回首页——读者正是从那一页点进来的
    const page = Math.floor(i / SITE.pageSize) + 1;
    return {
      params: { id: post.id },
      props: { post, backHref: page === 1 ? '/' : `/${page}` },
    };
  });
}) satisfies GetStaticPaths;

const { post, backHref } = Astro.props;
const { Content } = await render(post.entry);

// KaTeX 的样式和字体有 300 多 KB，只有真的写了公式的文章才值得加载。
// 站上 50 篇里目前只有个位数会用到。
const hasMath = /\$\$[\s\S]*?\$\$/.test(post.body);
---

<Base title={post.title} description={post.excerpt}>
  {hasMath && <link rel="stylesheet" href="/katex/katex.css" slot="head" />}
  {/* 阅读进度：只在文章页出现，列表页不需要 */}
  <div class="progress" aria-hidden="true"></div>

  <article class="article">
    <a class="back" href={backHref}>← BACK</a>
    <div class="stamp">
      {formatDate(post.date)} · {post.tag} · {post.mins} MIN READ
      {post.updated && post.updated > post.date && (
        <span class="revised">更新于 {formatDate(post.updated)}</span>
      )}
    </div>
    <h1>{post.title}</h1>
    <div class="rule" aria-hidden="true"></div>
    <div class="prose">
      <Content />
    </div>

    <footer class="post-end">
      <div class="post-end-label">写信 <span>WRITE BACK</span></div>
      <p>
        如果这篇恰好对你有用，或者你只是想说点什么——<a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
    </footer>
  </article>
</Base>
