---
import '../styles/global.css';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** 顶部导航高亮项 */
  section?: 'writing' | 'about';
}

const { title, description = SITE.intro, section = 'writing' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? Astro.url)} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400&family=Noto+Serif+SC:wght@400;600;700&display=swap"
    />
  </head>
  <body>
    <div class="shell">
      <header class="masthead">
        <a class="brand" href="/">{SITE.title}</a>
        <nav>
          <a href="/" aria-current={section === 'writing' ? 'page' : undefined}>Writing</a>
          <a href="/about" aria-current={section === 'about' ? 'page' : undefined}>About</a>
        </nav>
      </header>

      <slot />

      <footer class="footer">
        <span>© {SITE.since} {SITE.title}</span>
        <span>{SITE.motto}</span>
      </footer>
    </div>
  </body>
</html>
