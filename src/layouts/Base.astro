---
import '../styles/global.css';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** 顶部导航高亮项 */
  section?: 'writing' | 'about';
}

const { title, description = SITE.intro, section = 'writing' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? Astro.url)} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400&family=Noto+Serif+SC:wght@400;600;700&display=swap"
    />

    <!-- 图片加载失败时换成占位块，避免浏览器那个破图标。
         CSS 没有「加载失败」选择器，只能靠 JS；error 事件不冒泡，
         所以在 window 上用捕获阶段监听。 -->
    <script is:inline>
      document.addEventListener(
        'error',
        function (e) {
          var img = e.target;
          if (!img || img.tagName !== 'IMG' || img.dataset.fallback) return;
          img.dataset.fallback = '1';
          var alt = (img.getAttribute('alt') || '').trim();
          var box = document.createElement('div');
          box.className = 'img-missing';
          box.textContent = alt && alt.toLowerCase() !== 'image' ? alt : '图片已失效';
          img.replaceWith(box);
        },
        true,
      );
    </script>
  </head>
  <body>
    <div class="shell">
      <header class="masthead">
        <a class="brand" href="/">{SITE.title}</a>
        <nav>
          <a href="/" aria-current={section === 'writing' ? 'page' : undefined}>Writing</a>
          <a href="/about" aria-current={section === 'about' ? 'page' : undefined}>About</a>
        </nav>
      </header>

      <slot />

      <footer class="footer">
        <span>© {SITE.since} {SITE.title}</span>
        <span>{SITE.motto}</span>
      </footer>
    </div>
  </body>
</html>
