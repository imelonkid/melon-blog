---
import Base from '../layouts/Base.astro';
import { allPosts, formatDate } from '../lib/posts';

// 404 上给几条最近的文章，让读者能就地回到正轨，而不是只有一个死胡同
const recent = (await allPosts()).slice(0, 5);
---

<Base title="页面不存在" description="这个地址没有对应的内容。">
  <main class="article">
    <div class="stamp">404 · NOT FOUND</div>
    <h1>这里没有东西</h1>
    <div class="rule" aria-hidden="true"></div>
    <div class="prose">
      <p>你要找的页面不存在。可能是地址打错了，也可能这篇文章换了地方。</p>
    </div>

    <section class="recent">
      <div class="recent-label">最近写的</div>
      <ul>
        {recent.map((post) => (
          <li>
            <a href={`/posts/${post.id}`}>
              <span class="date">{formatDate(post.date)}</span>
              <span class="title">{post.title}</span>
            </a>
          </li>
        ))}
      </ul>
      <a class="back" href="/">← 回到首页</a>
    </section>
  </main>
</Base>
