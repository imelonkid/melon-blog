---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** 顶部导航高亮项 */
  section?: 'writing' | 'about';
}

const { title, description = SITE.intro, section = 'writing' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
// 版权年份的末年在构建时取当前年，不会随时间过期
const thisYear = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    <!-- 分享到微信、Twitter 等平台时的标题卡片 -->
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />

    <ClientRouter />

    <!-- ClientRouter 会把 history.scrollRestoration 设为 manual，交给它自己
         在脚本执行后恢复滚动。这对客户端翻页是对的，但整页刷新时会先在顶部
         绘制一帧再跳回原位置，看起来就是闪一下。整页刷新不属于客户端路由，
         交还给浏览器原生恢复——它在首次绘制前就定位好了，没有闪烁。 -->
    <script is:inline>
      // 只在真正的整页加载时接管；客户端切换走的是 astro:* 事件，不经过这里
      if ('scrollRestoration' in history) history.scrollRestoration = 'auto';
      document.addEventListener('astro:before-preparation', () => {
        history.scrollRestoration = 'manual';
      });
      document.addEventListener('astro:page-load', () => {
        history.scrollRestoration = 'auto';
      });
    </script>

    <!-- 按需注入的样式，例如只有含公式的文章才引入 KaTeX -->
    <slot name="head" />

    <link
      rel="preload"
      href="/fonts/brand-mashanzheng.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/*
      自建埋点。只发到本站的 /_a——服务端写一行日志就返回 204，没有第三方、
      没有 cookie，log_format 里也没有 IP 和 UA。爬虫不执行 JS，所以这份数据
      天生干净，不用维护一串 bot 正则。

      放在 head 里：ClientRouter 切页时 head 不重新执行，监听器只注册一次，
      靠 astro:page-load 驱动每一次页面（含客户端翻页）。

      发两个事件：
        view  进入页面
        read  滚过 70% 或停留满 30 秒——对博客来说完读率比 PV 有意义，
              PV 说明标题吸引人，完读率才说明正文站得住

      注意：这段是 is:inline，写在里面的注释会原样发给每一位读者。
      所以解释放在这个 {…} 注释里（编译时丢弃），脚本内只留必要的短注。
    */}
    <script is:inline>
      (function () {
        // 尊重 DNT；本地不发，免得自己调试污染数据
        if (navigator.doNotTrack === '1' || /^(localhost|127\.|\[?::1)/.test(location.hostname)) return;
        var vid;
        try {
          vid = localStorage.getItem('_v');
          if (!vid) { vid = Math.random().toString(36).slice(2, 10); localStorage.setItem('_v', vid); }
        } catch (e) { vid = 'anon'; }  // 隐私模式存不了就不区分访客
        var t0 = 0, deep = false, done = true;
        function send(ev, dwell) {
          var ref = '';
          try {
            var r = document.referrer;
            if (r && new URL(r).host !== location.host) ref = new URL(r).host;
          } catch (e) {}
          var u = '/_a?e=' + ev + '&v=' + vid + '&p=' + encodeURIComponent(location.pathname)
            + '&r=' + encodeURIComponent(ref) + '&w=' + innerWidth + (dwell ? '&d=' + dwell : '');
          if (navigator.sendBeacon) navigator.sendBeacon(u); else new Image().src = u;
        }
        function finish() {
          if (done) return;
          var d = Math.round((Date.now() - t0) / 1000);
          if (deep || d >= 30) { done = true; send('read', d); }
        }
        document.addEventListener('astro:page-load', function () {
          t0 = Date.now(); deep = false; done = false; send('view');
        });
        document.addEventListener('astro:before-preparation', finish);
        addEventListener('pagehide', finish);
        document.addEventListener('visibilitychange', function () {
          if (document.visibilityState === 'hidden') finish();
        });
        addEventListener('scroll', function () {
          if (deep) return;
          var h = document.documentElement;
          if (h.scrollHeight && (h.scrollTop + innerHeight) / h.scrollHeight > 0.7) deep = true;
        }, { passive: true });
      })();
    </script>

    <!-- 图片加载失败时换成占位块，避免浏览器那个破图标。
         CSS 没有「加载失败」选择器，只能靠 JS；error 事件不冒泡，
         所以在 window 上用捕获阶段监听。 -->
    <script is:inline>
      document.addEventListener(
        'error',
        function (e) {
          var img = e.target;
          if (!img || img.tagName !== 'IMG' || img.dataset.fallback) return;
          img.dataset.fallback = '1';
          var alt = (img.getAttribute('alt') || '').trim();
          var box = document.createElement('div');
          box.className = 'img-missing';
          box.textContent = alt && alt.toLowerCase() !== 'image' ? alt : '图片已失效';
          img.replaceWith(box);
        },
        true,
      );
    </script>
  </head>
  <body>
    <div class="shell">
      <header class="masthead">
        <a class="brand" href="/">
          <img
            class="brand-mark"
            src="/logo/logo.png"
            srcset="/logo/logo.png 1x, /logo/logo@2x.png 2x"
            alt=""
            width="56"
            height="72"
          />
          <span>{SITE.title}</span>
        </a>
        <nav>
          <a href="/" aria-current={section === 'writing' ? 'page' : undefined}>Writing</a>
          <a href="/about" aria-current={section === 'about' ? 'page' : undefined}>About</a>
        </nav>
      </header>

      <slot />

      <footer class="footer">
        <span>© {SITE.since}–{thisYear} {SITE.title}</span>
        <a
          class="icp"
          href="https://beian.miit.gov.cn/"
          target="_blank"
          rel="noopener noreferrer"
        >{SITE.icp}</a>
        <span>{SITE.motto}</span>
      </footer>
    </div>
  </body>
</html>
