.location-bar
  position: relative
  .line-1
    margin-bottom: 2px
  .text
    text-align: center
    text-size(s-1)
    margin: 0.2em 0
    padding: 0 4rem
    overflow: hidden
    text-overflow:ellipsis
    white-space: nowrap
  .line-1,.line-2,.line-3
    background: $color-black-2
    
  .nav-container
    display: flex
    justify-content: center
    align-items: center
    margin: 0.5rem 0
    flex-wrap: wrap
    
    .nav-item
      display: inline-block
      padding: 0.3rem 1rem
      margin: 0 0.5rem
      color: #2c3e50
      text-decoration: none
      font-size: 1.5rem
      transition: all 0.3s ease
      
      &:hover
        color: $color-main
        
      &:active, &.active
        color: $color-main
        font-weight: bold
        
    .search-container
      display: flex
      align-items: center
      margin: 0 0.5rem
      
      .search-button
        background: none
        border: none
        cursor: pointer
        padding: 0.3rem
        color: #2c3e50
        transition: all 0.3s ease
        
        &:hover
          color: $color-main
          
        .search-icon
          font-style: normal
          font-size: 1.5rem

// 搜索遮罩层
.search-overlay
  position: fixed
  top: 0
  left: 0
  width: 100%
  height: 100%
  background: rgba(0, 0, 0, 0.5)
  z-index: 999
  display: none

// 搜索模态框样式
.search-modal
  position: fixed
  top: 50%
  left: 50%
  transform: translate(-50%, -50%)
  width: 80%
  max-width: 600px
  background: #fff
  border-radius: 8px
  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.2)
  z-index: 1000
  padding: 20px
  display: none
  
  .search-close
    position: absolute
    top: 10px
    right: 15px
    font-size: 24px
    line-height: 1
    cursor: pointer
    color: #999
    transition: color 0.3s
    z-index: 2
    background: none
    border: none
    padding: 0
    margin: 0
    
    &:hover
      color: #333
  
  .search-input-container
    margin-top: 20px
    margin-bottom: 15px
    position: relative
    
    .search-input
      width: 100%
      padding: 10px 15px
      border: 1px solid #ddd
      border-radius: 4px
      font-size: 16px
      transition: all 0.3s ease
      
      &:focus
        outline: none
        border-color: $color-main
  
  .search-loading, .search-no-results
    text-align: center
    padding: 20px
    color: #666
  
  .search-results-list
    max-height: 60vh
    overflow-y: auto
    
    .search-result-item
      padding: 15px 0
      border-bottom: 1px solid #eee
      
      &:last-child
        border-bottom: none
      
      .search-result-title
        display: block
        font-size: 18px
        color: $color-main
        margin-bottom: 8px
        text-decoration: none
        
        &:hover
          text-decoration: underline
      
      .search-result-content
        font-size: 14px
        color: #666
        line-height: 1.5
        
        .search-keyword
          background-color: rgba(255, 230, 0, 0.5)
          padding: 0 2px
          border-radius: 2px

// 移动端适配
@media (max-width: 768px)
  .search-modal
    width: 95%