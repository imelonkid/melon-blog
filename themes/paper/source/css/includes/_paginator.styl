.paginator
  display: flex
  justify-content: center
  align-items: center
  font-size: 1.3rem
  margin: 3rem 0
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Open Sans", "Helvetica Neue", sans-serif

  a
    text-decoration: none !important
    &:hover, &:visited, &:active, &:focus
      text-decoration: none !important

  .space, .extend
    display: inline-flex
    align-items: center
    justify-content: center
    min-width: 3.5rem
    height: 3.5rem
    margin: 0 0.5rem
    padding: 0 1.2rem
    color: #999
    border-radius: 8px

  .page-number, .extend
    display: inline-flex
    align-items: center
    justify-content: center
    min-width: 3.5rem
    height: 3.5rem
    margin: 0 0.5rem
    padding: 0 1.2rem
    color: #2c3e50
    border-radius: 8px
    transition: all 0.3s ease
    background: transparent
    border: 2px solid transparent
    
    &:hover
      background: #f5f5f5
      color: $color-main
      border-color: $color-main
      text-decoration: none !important
    
    &.current
      background: $color-main
      color: white
      font-weight: 900
      font-size: 1.4rem
      min-width: 4rem
      height: 4rem
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1)
      
      &:hover
        background: $color-main
        color: white
        border-color: transparent
        text-decoration: none !important

  .extend
    font-weight: 500
    border: 2px solid #eee
    
    &:hover
      border-color: $color-main
      text-decoration: none !important
      
    &.prev
      margin-right: 0.8rem
      
    &.next
      margin-left: 0.8rem

  .space
    opacity: 0.5
    cursor: default

@media screen and (max-width: $S)
  .footer
    font-size: 10px;
