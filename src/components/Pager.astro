---
import type { Page } from 'astro';

interface Props { page: Page }
const { page } = Astro.props;

const DIGITS = ['〇', '一', '二', '三', '四', '五', '六', '七', '八', '九'];

/** 阿拉伯数字转中文（1–99，超出则退回数字） */
function cn(n: number): string {
  if (n < 1 || n > 99) return String(n);
  if (n < 10) return DIGITS[n];
  const [t, o] = [Math.floor(n / 10), n % 10];
  return (t > 1 ? DIGITS[t] : '') + '十' + (o ? DIGITS[o] : '');
}

const href = (n: number) => (n === 1 ? '/' : `/${n}`);

/**
 * 恒定显示三个页码：正常是「前一页 当前页 后一页」；
 * 位于首页时顺延为「当前 下一 下下」，位于末页时前移为「上上 上一 当前」。
 * 总页数不足 3 时有几页显示几页。
 */
function windowOf(current: number, last: number): number[] {
  if (last <= 3) return Array.from({ length: last }, (_, i) => i + 1);
  const start = Math.max(1, Math.min(current - 1, last - 2));
  return [start, start + 1, start + 2];
}

const items = windowOf(page.currentPage, page.lastPage);
---

{page.lastPage > 1 && (
  <nav class="pager" aria-label="分页">
    <a class:list={['step', { off: !page.url.prev }]} href={page.url.prev ?? '#'} aria-disabled={!page.url.prev}>上一页</a>
    <div class="nums">
      {items.map((n) => (
        <a class="num" href={href(n)} aria-current={n === page.currentPage ? 'page' : undefined}>{cn(n)}</a>
      ))}
    </div>
    <a class:list={['step', { off: !page.url.next }]} href={page.url.next ?? '#'} aria-disabled={!page.url.next}>下一页</a>
  </nav>
)}
