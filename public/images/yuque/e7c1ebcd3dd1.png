<svg xmlns:xlink="http://www.w3.org/1999/xlink" width="72.026ex" height="10.509ex" style="vertical-align: -4.384ex; margin-bottom: -0.287ex;" viewBox="0 -2513.6 31011.3 4524.8" role="img" focusable="false" xmlns="http://www.w3.org/2000/svg" aria-labelledby="MathJax-SVG-1-Title">
<title id="MathJax-SVG-1-Title">adjust(i, j) =
\begin{cases}
i -&gt; i1,  (i&lt;j) &amp; \text{左边界右滑}\\
j -&gt; j1, (i &gt; j) &amp; \text{右边界左滑} \\
i -&gt; i1, (i = j) &amp; \text{移动左右窗口都可以，这里移动左边界}
\end{cases}</title>
